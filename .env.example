# ===== Shopify 连接 =====
# 店铺 handle（.myshopify.com 前面那段）
SHOP=balloonstore1
# Dev Dashboard 里 app 的 client credentials，绝不提交 git
CLIENT_ID=
CLIENT_SECRET=
# Admin API 版本，只能写正式版本（YYYY-MM），不能用 unstable
API_VERSION=2026-07

# ===== 活动 =====
# 活动编号。数据放在 campaigns/<CAMPAIGN_ID>/，每张卡的内部备注会带上 [campaign:<CAMPAIGN_ID>]。
# 开始发放后不要再改；要重新选名单就换一个新编号。
CAMPAIGN_ID=2026-10
# 建卡后给客户打的 tag，不能含逗号。带这个 tag 的客户不会再收到卡
SENT_TAG=OCT26RTPROMO
# 只有显式改成 false 才会真的建卡、发邮件、打 tag。
# 这里保持 true，真实运行时在命令前加 DRY_RUN=false，例如 DRY_RUN=false node index.js issue --limit 20
DRY_RUN=true

# ---- 活动日期：格式 YYYY-MM-DD，按店铺时区（洛杉矶）计算 ----
# 首封邮件日期，也就是正式建卡的日期。正式活动在这一天之前不能运行 issue。例：2026-10-05
LAUNCH_DATE=2026-10-05
# 礼品卡到期日，也是最后可用日：这一天当天仍可使用。例：2026-10-19
# 到期日当天及以后 issue 不再建新卡（只补记和补打 tag）。邮件正文里的日期都由卡的到期日自动生成；
# 邮件主题里的 "Oct. 19th" 是写死的（Shopify 限制主题模板 512 字符），改了到期日要同时改主题模板再贴到后台，preview 会提醒。
GIFT_CARD_EXPIRES_ON=2026-10-19

# ---- 提醒邮件：用 Shopify Email 发送，不由本程序发 ----
# 发提醒前先跑一次 node index.js usage：它给已经用过卡的客户打 tag <SENT_TAG>-USED（例：OCT26RTPROMO-USED）。
# 然后在 Shopify Email 里把收件人条件设为（把 <SENT_TAG> 换成上面的 SENT_TAG）：
#   customer_tags CONTAINS '<SENT_TAG>' AND NOT customer_tags CONTAINS '<SENT_TAG>-USED'
# 这样只有还没用过卡的人会收到提醒。

# ===== 名单条件 =====
# 删掉某一行 = 用程序默认值（就是下面写的值）；写了但留空 = 不排除任何项
# 近几个月有有效订单的不发
INACTIVE_MONTHS=3
# 注册满几天才发
MIN_ACCOUNT_AGE_DAYS=7
# 只发给已订阅邮件营销（SUBSCRIBED）的人
REQUIRE_EMAIL_SUBSCRIBED=true
# 带任一 tag 的不发，不分大小写。former-fake-identified 按要求不排除
EXCLUDE_TAGS=WHS,PotentiallyWHS,DISC,level1A,level2A,DO NOT SELL,likely-fake-account,walmart.com,Walmart,Amazon,eBay
# 邮箱域名在这里的不发：平台中转或占位地址，以及 6 个公司域名
EXCLUDE_EMAIL_DOMAINS=example.com,mail.codisto.com,connectebay.com,marketplace.amazon.com,relay.walmart.com,members.ebay.com,jokerpartysupply.com,loftus.com,burtonandburton.com,mayflower.com,toyworld.com,rainbowballoons.com
# 最近一笔有效订单来自这些渠道的不发（订单的 sourceName）。
# 数字是 Shopify 里的应用编号：205641 = Sellbrite，1456995 = CedCommerce Walmart Connector，1775805 = eBay
EXCLUDE_ORDER_SOURCES=amazon,walmart,ebay,etsy,205641,1456995,1775805

# ===== 金额 =====
# 基数 = 上次有效订单总额 × GIFT_PERCENT%，四舍五入到分；从没下单的人用有下单入选者上次订单总额的平均值
GIFT_PERCENT=10
# 档位：基数 ≤ $10.77 发 $10.77；$10.78–$15.33 发 $15.33；$15.34 及以上发 $19.77
GIFT_TIERS=10.77,15.33,19.77
# 必须等于店铺货币
GIFT_CARD_CURRENCY=USD

# ===== 礼品卡 =====
# 卡上的内部备注（客户看不到）。程序会在后面加上 [campaign:<CAMPAIGN_ID>]
GIFT_CARD_NOTE=gift-card-promo
# 活动标记：程序建的每张卡都带这个 template suffix，后台手工发的卡没有。
# "Gift card created" 邮件用 gift_card.template_suffix == '<这个值>' 区分活动版和原版
# （见 notifications/），主题里也要有对应的 templates/gift_card.<这个值>.liquid。三处必须一致。
GIFT_CARD_TEMPLATE_SUFFIX=gift-card-promo
# 每次 issue 最多处理多少人（--limit 不能超过它）
ISSUE_MAX_PER_RUN=20000

# ===== 测试活动 =====
# 不要写在这个文件里。新建一个 .env.test，写下面几行（客户 ID 是后台客户页网址最后那串数字，逗号分隔）：
#   CAMPAIGN_ID=2026-10-test
#   SENT_TAG=OCT26RTPROMO-TEST
#   TEST_CUSTOMER_IDS=1234567890,2345678901
#   TEST_GIFT_AMOUNT=0.10
# 然后每条命令都这样运行：node --env-file=.env.test index.js select
# .env.test 里的值优先，其余仍取自 .env。设置了 TEST_CUSTOMER_IDS 时，select 只取这些客户、
# 不按名单条件筛选、金额固定为 TEST_GIFT_AMOUNT，CAMPAIGN_ID 必须含 test；不受首封日期限制
# （但到期日当天及以后同样不再建新卡）。

# ===== 其他（一般不用改）=====
# 店铺时区；不写 = 用店铺设置（America/Los_Angeles）
# TIMEZONE=America/Los_Angeles
# 活动数据目录；不写 = 项目里的 campaigns/
# CAMPAIGNS_DIR=
