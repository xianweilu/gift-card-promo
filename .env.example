# 店铺 handle（.myshopify.com 前面那段）
SHOP=balloonstore1
# Dev Dashboard 里 app 的 client credentials，绝不提交 git
CLIENT_ID=
CLIENT_SECRET=
API_VERSION=2026-07
# 要发卡的 segment
SEGMENT_ID=gid://shopify/Segment/488535490623
# 每页取多少成员。文档上限 1000，但 1000 会超过单次查询 1000 点的成本上限，250 是安全值
SEGMENT_PAGE_SIZE=250
# 第一阶段固定金额；第二阶段忽略
GIFT_CARD_VALUE=0.10
# 必须等于店铺货币
GIFT_CARD_CURRENCY=USD
# 卡上的内部备注（客户看不到）
GIFT_CARD_NOTE=IBC2026 test
# YYYY-MM-DD，留空 = 永不过期
GIFT_CARD_EXPIRES_ON=
# 例如 winback，等主题里有了 templates/gift_card.winback.liquid 再填
GIFT_CARD_TEMPLATE_SUFFIX=
# 发卡后给客户打的 tag；不能和 segment 自己用的 tag 撞车，不能含逗号。
# 脚本每次运行都会先查出所有已带这个 tag 的客户并跳过，所以即使 progress.json 丢了也不会重复发卡。
# 建议正式活动的 segment 条件也加上 AND NOT customer_tags CONTAINS '<这个 tag>'。
SENT_TAG=gift-card-sent-2026-09
# 只有显式改成 false 才会真的建卡、发邮件、打 tag
DRY_RUN=true
