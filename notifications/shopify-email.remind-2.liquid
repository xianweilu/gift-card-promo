            <p style="margin: 0 0 8px 0;">&copy; <a href="{{ shop.url }}" style="color: #1990C6;">LABalloons.com</a></p>
            <p style="margin: 0;">You received this email because you are subscribed to LA Balloons marketing emails. {{ unsubscribe_link }}</p>
          </td>
        </tr>
      </table>
      {{ open_tracking_block }}
    </td>
  </tr>
</table>
